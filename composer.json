{
    "name": "omnishow/vimeo",
    "type": "library",
    "description": "Omnishow's Vimeo, under any PHP host: a video's record (title, description, duration, thumbnails, date, its owner, its player and the do-not-track one with dnt=1), several in one call, a search, a user's videos, showcases as playlists - through Vimeo's API 3.4 with an access token, or an unauthenticated token from the application's client id and secret.",
    "keywords": [
        "vimeo",
        "video",
        "embed",
        "dnt",
        "showcase",
        "framework-agnostic",
        "omnishow"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnishow-vimeo",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnishow": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishow\\Vimeo\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishow\\Vimeo\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
